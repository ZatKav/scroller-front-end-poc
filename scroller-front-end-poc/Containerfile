FROM node:20-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_BASE_PATH=""
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH

# Install dependencies and build the Next.js app
COPY package*.json ./
RUN --mount=type=bind,source=.npmrc,target=/app/.npmrc npm ci
COPY . .
RUN npm run build

# Runtime image: only production deps and build output
FROM node:20-alpine AS runner
WORKDIR /app
ARG NEXT_PUBLIC_BASE_PATH=""
ENV NODE_ENV=production \
    PORT=8410 \
    NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH
RUN apk add --no-cache curl

COPY package*.json ./
RUN --mount=type=bind,source=.npmrc,target=/app/.npmrc npm ci --omit=dev

# Copy the standalone build output and public assets
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 8410
CMD ["node", "server.js"]
